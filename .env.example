APP_NAME=KamVerify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Public demo environment at /demo — signs visitors into a seeded demo
# customer account. Enabled automatically outside production; set
# DEMO_ENABLED=true to force-enable, or false to disable anywhere.
DEMO_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Laravel 11 uses MAIL_SCHEME, not MAIL_ENCRYPTION — "smtp" for STARTTLS
# (port 587) or "smtps" for implicit TLS (port 465).
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Inbox for admin activity emails (deposits, orders, refunds, tickets,
# registrations). Leave empty to disable admin email alerts.
ADMIN_NOTIFICATION_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seeded account passwords — REQUIRED in production: db:seed aborts if
# these are unset. Local/dev seeds fall back to "password".
ADMIN_SEED_PASSWORD=
CUSTOMER_SEED_PASSWORD=

# HeroSMS Provider Configuration
# mode: mock (development, simulated) or production (real API calls)
HERO_SMS_MODE=mock
HERO_SMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php
HERO_SMS_API_KEY=
# Deprecated: kept for backwards compatibility — use HERO_SMS_MODE
HERO_SMS_USE_MOCK=true
# Reseller: once HeroSMS grants reseller status, enable this so the
# buyer's KamVerify user ID is sent with each activation — per-buyer
# bans then apply instead of account-wide ones. Param name per the
# SMS-Activate-compatible protocol; confirm at reseller onboarding.
HERO_SMS_RESELLER_ENABLED=false
HERO_SMS_RESELLER_PARAM=userId

# TextVerified — fulfils Facebook/Meta verifications only (US numbers).
# HeroSMS stays the provider for WhatsApp, Telegram, TikTok, etc.
# mode: mock (tests only — throws if enabled in production) or production.
# Auth: bearer token generated from X-API-KEY + X-API-USERNAME (your
# TextVerified account email) via POST /api/pub/v2/auth, cached until
# expiry. Real values go in .env — never commit them.
TEXTVERIFIED_ENABLED=false
TEXTVERIFIED_MODE=production
TEXTVERIFIED_BASE_URL=https://www.textverified.com
TEXTVERIFIED_API_KEY=
TEXTVERIFIED_EMAIL=
TEXTVERIFIED_TIMEOUT=30

# Fapshi Payment Configuration (https://docs.fapshi.com)
# mode: sandbox (sandbox.fapshi.com) or live (live.fapshi.com)
# Credentials come from a Service in the Fapshi dashboard — apiuser/apikey headers.
FAPSHI_MODE=sandbox
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Dev/test shortcut: simulated payments that credit instantly. Must be
# false in production (the provider throws if mock is on in prod).
FAPSHI_USE_MOCK=true

# Web Push (VAPID) — generate keys with:
# php artisan tinker --execute="var_export(\Minishlink\WebPush\VAPID::createVapidKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Payment Configuration
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
COINBASE_API_KEY=
COINBASE_API_SECRET=
